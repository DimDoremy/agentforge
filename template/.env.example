# --- LLM ---------------------------------------------------------------------
# Provider-agnostic model string consumed by langchain's init_chat_model.
# Examples: "openai:gpt-4o-mini", "anthropic:claude-3-5-sonnet-latest".
MODEL=openai:gpt-4o-mini

# Set ONLY the key(s) for the provider(s) you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Postgres platform -------------------------------------------------------
# IMPORTANT (networking-rules.md): inside the container this MUST use the
# compose SERVICE NAME `postgres`, never 127.0.0.1. Host-side tools (psql, GUI)
# connect to 127.0.0.1:5432 against the dev compose's published port instead.
DB_DSN=postgresql://postgres:postgres@postgres:5432/agentforge?sslmode=disable
DB_NAME=agentforge
DB_USER=postgres
DB_PASSWORD=postgres

# --- HTTP --------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
